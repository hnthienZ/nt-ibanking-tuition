NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
AUTH_DB=ibanking_auth
TUITION_DB=ibanking_tuition
PAYMENT_DB=ibanking_payment
NOTIFICATION_DB=ibanking_notification
GATEWAY_PORT=4000
AUTH_PORT=4001
TUITION_PORT=4002
PAYMENT_PORT=4003
NOTIFICATION_PORT=4004
AUTH_URL=http://127.0.0.1:4001
TUITION_URL=http://127.0.0.1:4002
PAYMENT_URL=http://127.0.0.1:4003
NOTIFICATION_URL=http://127.0.0.1:4004
FRONTEND_URL=http://127.0.0.1:5173
APP_MODE=development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_google_app_password
MAIL_FROM='"NT iBANKING" <your_email@gmail.com>'
OTP_PEPPER=
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=3
DEMO_EMAIL=demo@example.com
DEMO2_EMAIL=demo2@example.com
DEMO3_EMAIL=demo3@example.com

# Leave SMTP_HOST, SMTP_USER, SMTP_PASS and MAIL_FROM empty to run without email.
# In that case the notification service stays available, but OTP/receipt requests return HTTP 503.
